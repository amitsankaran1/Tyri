{
  "data": {
    "type": "ciWorkflows",
    "attributes": {
      "name": "Tyri PR checks",
      "description": "Current-revision simulator checks; no distribution. Deterministic suites run in ci_post_clone.sh.",
      "containerFilePath": "Tyri.xcodeproj",
      "isEnabled": true,
      "clean": true,
      "pullRequestStartCondition": {
        "source": {
          "isAllMatch": true
        },
        "destination": {
          "patterns": [
            {
              "pattern": "main",
              "isPrefix": false
            }
          ]
        },
        "autoCancel": true
      },
      "manualBranchStartCondition": {
        "source": {
          "isAllMatch": true
        }
      },
      "actions": [
        {
          "name": "Build iOS simulator",
          "actionType": "BUILD",
          "destination": "ANY_IOS_SIMULATOR",
          "scheme": "Tyri",
          "platform": "IOS",
          "isRequiredToPass": true
        },
        {
          "name": "Test iOS",
          "actionType": "TEST",
          "scheme": "Tyri",
          "platform": "IOS",
          "isRequiredToPass": true,
          "testConfiguration": {
            "kind": "USE_SCHEME_SETTINGS",
            "testDestinations": [
              {
                "kind": "SIMULATOR",
                "deviceTypeName": "iPhone 18 Pro",
                "deviceTypeIdentifier": "com.apple.CoreSimulator.SimDeviceType.iPhone-18-Pro",
                "runtimeName": "iOS 27.2",
                "runtimeIdentifier": "com.apple.CoreSimulator.SimRuntime.iOS-27-2"
              }
            ]
          }
        },
        {
          "name": "Analyze iOS",
          "actionType": "ANALYZE",
          "destination": "ANY_IOS_SIMULATOR",
          "scheme": "Tyri",
          "platform": "IOS",
          "isRequiredToPass": true
        }
      ]
    },
    "relationships": {
      "product": {
        "data": {
          "type": "ciProducts",
          "id": "4b792aee-e88d-4d54-b834-3b7837a7cd28"
        }
      },
      "repository": {
        "data": {
          "type": "scmRepositories",
          "id": "3111bb30-22b7-4250-9b13-9160d3dd6233"
        }
      },
      "xcodeVersion": {
